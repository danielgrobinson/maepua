---
import type { CollectionEntry } from 'astro:content';
import { formatDate, route } from '../lib/site';

interface Props {
	update: CollectionEntry<'updates'>;
}

const { update } = Astro.props;
---

<article class="article-card">
	<a class="article-thumb" href={route(`updates/${update.id}/`)}>
		<img src={route(update.data.cover)} alt={update.data.coverAlt} loading="lazy" />
	</a>
	<div>
		<div class="article-meta">
			<time datetime={update.data.date.toISOString()}>{formatDate(update.data.date)}</time>
			<span>{update.data.readingTime}</span>
		</div>
		<h3><a href={route(`updates/${update.id}/`)}>{update.data.title}</a></h3>
		<p>{update.data.deck}</p>
	</div>
</article>
