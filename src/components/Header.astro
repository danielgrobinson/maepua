---
import { route, SITE } from '../lib/site';

const currentPath = Astro.url.pathname;
const links = [
	{ label: 'Story', href: route('#story') },
	{ label: 'Take part', href: route('#take-part') },
	{ label: 'Updates', href: route('updates/') },
];
---

<header class="site-header">
	<a class="brand" href={route()} aria-label={`${SITE.name} home`}>
		<span class="brand-sun" aria-hidden="true"></span>
		<span>E Pluribus Unum</span>
	</a>
	<nav aria-label="Primary navigation">
		{links.map((link) => (
			<a
				class:list={[
					'nav-link',
					{ active: !link.href.includes('#') && currentPath.startsWith(link.href) },
				]}
				href={link.href}
			>
				{link.label}
			</a>
		))}
	</nav>
</header>
