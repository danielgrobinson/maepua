---
import { getCollection } from 'astro:content';
import UpdateCard from '../components/UpdateCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { route } from '../lib/site';

const updates = (await getCollection('updates'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 2);
---

<BaseLayout>
	<section class="project-hero">
		<div class="project-hero-copy">
			<p class="eyebrow">A civic art project</p>
			<h1>Make America <em>E Pluribus Unum</em> Again.</h1>
			<p class="hero-intro">
				A reminder that the American experiment begins with a demanding idea:
				<strong>out of many, one.</strong>
			</p>
			<div class="hero-actions">
				<a class="button primary" href="#story">Read the story</a>
				<a class="text-link" href="#take-part"
					>Take part <span aria-hidden="true">→</span></a
				>
			</div>
		</div>
		<div class="project-mark">
			<img
				src={route('images/e-pluribus-unum-mark.svg')}
				alt="Make America E Pluribus Unum Again rising-sun mark"
			/>
		</div>
	</section>

	<section class="section-block motto-section" id="story">
		<div class="section-heading">
			<div>
				<p class="eyebrow">The motto</p>
				<h2>Out of many, one.</h2>
			</div>
		</div>
		<div class="history-grid">
			<div class="history-lead">
				<p>
					<em>E Pluribus Unum</em> is Latin for “Out of many, one.” It describes a union
					formed from distinct states, communities, histories, and people without asking
					them to become identical.
				</p>
			</div>
			<div class="prose history-copy">
				<h3>Present from the founding era</h3>
				<p>
					The phrase entered the design of the Great Seal during the nation’s earliest
					years and appeared on the seal adopted by Congress in 1782. It later became
					familiar on official documents, government symbols, and American coins.
				</p>
				<p>
					For generations, <em>E Pluribus Unum</em> functioned as the country’s de facto
					motto. In 1956, Congress formally established “In God We Trust” as the national
					motto, but the older phrase remained on the Great Seal and in public life.
				</p>
				<h3>A continuing promise</h3>
				<p>
					The words do not claim that unity is automatic. They set a standard: difference
					is real, disagreement is inevitable, and the work of building a shared country
					still belongs to all of us.
				</p>
			</div>
		</div>
	</section>

	<section class="statement-band project-statement">
		<p class="eyebrow">The project</p>
		<blockquote>
			Put an old American promise back into everyday view—and invite people to consider what
			it asks of us now.
		</blockquote>
	</section>

	<section class="section-block purpose-section">
		<div class="section-heading">
			<div>
				<p class="eyebrow">Why this project</p>
				<h2>A shared phrase for a divided moment.</h2>
			</div>
		</div>
		<div class="purpose-grid">
			<p class="purpose-intro">
				Make America E Pluribus Unum Again uses a familiar civic phrase as public art: on
				shirts, postcards, and materials meant to move from person to person.
			</p>
			<div class="prose">
				<p>
					The project is not a call for everyone to think, worship, vote, or live in the
					same way. It is an argument that pluralism and national belonging can exist
					together—and that a democratic society depends on both.
				</p>
				<p>
					The rising-sun mark treats the motto as something active rather than archival:
					an idea worth carrying forward, sharing with friends, and placing where it can
					start a conversation.
				</p>
			</div>
		</div>
	</section>

	<section class="section-block participation-section" id="take-part">
		<div class="section-heading">
			<div>
				<p class="eyebrow">Take part</p>
				<h2>Wear it. Print it. Pass it on.</h2>
			</div>
		</div>
		<div class="participation-grid">
			<article class="action-card">
				<p class="action-number">01</p>
				<h3>Wear the message</h3>
				<p>
					A small collection of shirts will make the mark visible in ordinary public
					spaces and help support the next round of project materials.
				</p>
				<span class="button disabled" aria-disabled="true">Shirts coming soon</span>
			</article>
			<article class="action-card">
				<p class="action-number">02</p>
				<h3>Share a postcard</h3>
				<p>
					Print-ready postcard files will be free to download, reproduce, and distribute
					to friends, neighbors, classrooms, and community groups.
				</p>
				<span class="button disabled" aria-disabled="true">Files coming soon</span>
			</article>
		</div>
	</section>

	<section class="section-block updates-preview">
		<div class="section-heading">
			<div>
				<p class="eyebrow">Project log</p>
				<h2>Updates and next steps</h2>
			</div>
			<a class="text-link" href={route('updates/')}
				>View all updates <span aria-hidden="true">→</span></a
			>
		</div>
		<div class="article-list">
			{updates.map((update) => <UpdateCard update={update} />)}
		</div>
	</section>
</BaseLayout>
